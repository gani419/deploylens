{
  "name": "@deploylens/mobile",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest --runInBand",
    "build": "pnpm typecheck && pnpm bundle:android && pnpm bundle:ios",
    "typecheck": "tsc --noEmit",
    "bundle:android": "node scripts/bundle.cjs android",
    "bundle:ios": "node scripts/bundle.cjs ios",
    "android:build": "cd android && gradlew.bat assembleDebug",
    "doctor": "react-native doctor"
  },
  "dependencies": {
    "@deploylens/api-client": "workspace:*",
    "@deploylens/config": "workspace:*",
    "@deploylens/contracts": "workspace:*",
    "@deploylens/reporting": "workspace:*",
    "@deploylens/store": "workspace:*",
    "@deploylens/utils": "workspace:*",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-native-documents/picker": "12.0.3",
    "@react-navigation/bottom-tabs": "7.21.0",
    "@react-navigation/native": "7.5.1",
    "@react-navigation/native-stack": "7.21.0",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-blob-util": "0.25.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.0",
    "react-native-share": "^12.3.1",
    "react-native-svg": "15.16.0"
