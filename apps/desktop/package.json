{
  "name": "@deploylens/desktop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist-electron/main.js",
  "scripts": {
    "dev": "pnpm run build && electron .",
    "build:renderer": "tsc --noEmit && vite build",
    "build:electron": "tsc -p tsconfig.electron.json && esbuild electron/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/preload.cjs",
    "build": "pnpm run build:renderer && pnpm run build:electron",
    "start": "electron .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "preview": "vite"
  },
  "dependencies": {
    "@deploylens/contracts": "workspace:*",
    "@deploylens/core": "workspace:*",
    "@deploylens/ui-web": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@deploylens/config": "workspace:*",
    "@deploylens/utils": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.3.4",
    "electron": "34.3.0",
    "rimraf": "6.0.1",
    "typescript": "5.8.2",
    "vite": "6.2.0",
    "esbuild": "0.25.12"
  }
}
