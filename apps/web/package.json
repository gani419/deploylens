{
  "name": "@deploylens/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/generate-theme.mjs && tsc --noEmit && vite build",
    "start": "pnpm --filter @deploylens/server start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@deploylens/contracts": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@deploylens/config": "workspace:*",
    "@deploylens/utils": "workspace:*",
    "@deploylens/reporting": "workspace:*",
    "@deploylens/store": "workspace:*",
    "@deploylens/api-client": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.8.2",
    "vite": "6.2.0"
  }
}
