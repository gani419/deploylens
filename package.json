{
  "name": "deploylens-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "DeployLens - Fully local mobile app build inspection tool",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },

  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build && pnpm -r --filter \"./apps/*\" run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "cli": "pnpm --filter @deploylens/cli run start",
    "desktop": "pnpm --filter @deploylens/desktop run dev",
    "desktop:build": "pnpm --filter @deploylens/desktop run build",
    "lint": "pnpm -r run lint"
  },
  "devDependencies": {
    "@types/node": "22.13.9",
    "typescript": "5.8.2",
    "vitest": "3.0.7"
  }
}
